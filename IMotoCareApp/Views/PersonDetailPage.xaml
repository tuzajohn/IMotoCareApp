<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IMotoCareApp.Views.PersonDetailPage"
             Title="Profile">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Border StrokeThickness="0" BackgroundColor="White" HasShadow="True">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*">
                    <Image Source="{Binding ImageUri}" HeightRequest="220" Aspect="AspectFill" />
                    <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="0,16,0,0">
                        <Label Text="{Binding FullName}" FontSize="26" FontAttributes="Bold" />
                        <Label Text="{Binding Type}" FontSize="14" TextColor="{DynamicResource PrimaryColor}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="2" Spacing="4" Margin="0,12,0,0">
                        <Label Text="Garage" FontAttributes="Bold" />
                        <Label Text="{Binding GarageName}" TextColor="{DynamicResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="3" Spacing="4" Margin="0,12,0,0">
                        <Label Text="Address" FontAttributes="Bold" />
                        <Label Text="{Binding Address}" TextColor="{DynamicResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="4" Spacing="4" Margin="0,12,0,0">
                        <Label Text="Contact" FontAttributes="Bold" />
                        <Label Text="{Binding Contact}" TextColor="{DynamicResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <Button Text="Call now" HorizontalOptions="Fill" Clicked="OnCallClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
